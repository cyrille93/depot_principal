# ───────────────────────────────────────────────────────────
# Variables d'environnement — Rose Annonce
# Copiez ce fichier en ".env" (développement) ou configurez ces
# variables sur votre hébergeur (production). Ne committez jamais .env.
# ───────────────────────────────────────────────────────────

# Base de données PostgreSQL
# Dév (Docker local) :
DATABASE_URL="postgresql://postgres:confiance2026@localhost:5433/confiance?schema=public"
# Prod : utilisez l'URL fournie par votre Postgres managé (Neon, Supabase, RDS…)

# Secret d'authentification (OBLIGATOIRE en production)
# Générez-en un avec :  openssl rand -base64 32
AUTH_SECRET="à_remplacer_par_un_secret_aléatoire"

# URL publique du site (OBLIGATOIRE en production pour le SEO : sitemap, canonical, Open Graph)
# Dév :
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Prod :
# NEXT_PUBLIC_SITE_URL="https://roseannonce.com"

# (À venir) Stockage CDN des photos — à renseigner quand le compte sera créé
# CDN_ENDPOINT=""
# CDN_ACCESS_KEY=""
# CDN_SECRET_KEY=""
# CDN_BUCKET=""

# (À venir) Mobile Money — agrégateur de paiement
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# --- CinetPay (Mobile Money) ---
# Récupère ces valeurs dans ton tableau de bord CinetPay (mode test pour le sandbox).
CINETPAY_API_KEY="ta_cle_api_cinetpay"
CINETPAY_SITE_ID="ton_site_id_cinetpay"
# (NEXT_PUBLIC_SITE_URL est déjà définie plus haut — elle sert aussi aux URL
#  de notification/retour CinetPay, pas besoin de la répéter ici.)

# --- Vercel Blob (hébergement des vidéos : galerie + annonces) ---
# Jeton de lecture/écriture du Blob Store. En PRODUCTION, Vercel l'injecte
# automatiquement dès que tu connectes un Blob Store au projet
# (Dashboard Vercel → Storage → Blob). En DÉVELOPPEMENT local, copie la
# valeur depuis Vercel (Storage → ton Blob Store → ".env.local") et colle-la ici.
BLOB_READ_WRITE_TOKEN=""

# --- API Admin (Power Apps) — authentification Microsoft Entra ID (OAuth2) ---
# API privée /api/admin/* réservée à l'app d'administration Power Apps.
# Ces valeurs viennent de l'app registration Entra ID qui représente l'API.
#   ENTRA_TENANT_ID     : GUID (ou domaine) de ton tenant Entra ID / Microsoft 365
#   ENTRA_API_AUDIENCE  : audience attendue du jeton = App ID URI de l'API (ex. api://<client-id>)
#   ENTRA_REQUIRED_ROLE : nom du rôle admin exigé dans le jeton (défaut: RoseAnnonce.Admin)
ENTRA_TENANT_ID=""
ENTRA_API_AUDIENCE=""
ENTRA_REQUIRED_ROLE="RoseAnnonce.Admin"
